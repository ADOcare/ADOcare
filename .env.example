# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

APP_NAME=adocare
APP_ENV=
APP_KEY=
APP_DEBUG=false
APP_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=adocare
DB_USERNAME=root
DB_PASSWORD=secret


# -----------------------------------------------------------------------------
# Session
# -----------------------------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax


# -----------------------------------------------------------------------------
# Laravel services
# -----------------------------------------------------------------------------

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database


# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=hello@studiokristian.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@studiokristian.com
MAIL_FROM_NAME="${APP_NAME}"


# -----------------------------------------------------------------------------
# Frontend / Vite
# -----------------------------------------------------------------------------

VITE_API_BASE_URL=/api

VITE_PRIMEVUE_LICENSE_KEY=


# -----------------------------------------------------------------------------
# Maps / Routing
# -----------------------------------------------------------------------------

GOOGLE_MAPS_API_KEY=

ORS_API_KEY=

ROUTE_SERVICE_BASE_URL=http://127.0.0.1:1515
ROUTE_SERVICE_ENDPOINT=/tsp-solver
ROUTE_SERVICE_TIMEOUT=3300


# -----------------------------------------------------------------------------
# OCR
# -----------------------------------------------------------------------------

OCR_SERVICE_URL=http://127.0.0.1:8081


# -----------------------------------------------------------------------------
# UDZS
# -----------------------------------------------------------------------------

UDZS_BASE_URL=https://api.udzs-sk.sk/api
UDZS_EMAIL=office_enm_centrum.sk@udzs-sk.sk
UDZS_PASSWORD=
UDZS_COOKIESESSION1=
UDZS_TOKEN_TTL=3300
UDZS_TIMEOUT=10


# -----------------------------------------------------------------------------
# eOverenie
# -----------------------------------------------------------------------------

EOVERENIE_EMAIL=
EOVERENIE_PASSWORD=
EOVERENIE_BASE_URL=https://eportalapi.udzs-sk.sk/api/external/
EOVERENIE_TIMEOUT=10
EOVERENIE_TOKEN_TTL=3300


# -----------------------------------------------------------------------------
# StudioKristian billing
# -----------------------------------------------------------------------------

STUDIOKRISTIAN_BILLING_URL=
STUDIOKRISTIAN_BILLING_PROJECT_TOKEN=
STUDIOKRISTIAN_BILLING_TIMEOUT=10
STUDIOKRISTIAN_BILLING_CONNECT_TIMEOUT=5
STUDIOKRISTIAN_BILLING_PLANS_CACHE_TTL=300

ADOCARE_TRIAL_DAYS=14


# -----------------------------------------------------------------------------
# Google Cloud
# -----------------------------------------------------------------------------

GOOGLE_APPLICATION_CREDENTIALS=/etc/secure/keys/adocare-b656b9a67f50.json


# -----------------------------------------------------------------------------
# Google Cloud Storage (backups and AI datasets)
# -----------------------------------------------------------------------------

GOOGLE_CLOUD_PROJECT_ID=adocare
GOOGLE_CLOUD_KEY_FILE_PATH=/etc/secure/keys/adocare-b656b9a67f50.json
GOOGLE_CLOUD_STORAGE_BACKUP_BUCKET=adocare-backups
GOOGLE_CLOUD_STORAGE_PATH_PREFIX=app


# -----------------------------------------------------------------------------
# Vertex AI
# -----------------------------------------------------------------------------

VERTEX_PROJECT_ID=adocare
VERTEX_LOCATION=europe-west1


# Proposal model
# -----------------------------------------------------------------------------

VERTEX_PROPOSAL_LOCATION=europe-southwest1
VERTEX_PROPOSAL_ENDPOINT_ID=8539401037587415040


# Dekurz model
# -----------------------------------------------------------------------------

VERTEX_DEKURZ_LOCATION=europe-southwest1
VERTEX_DEKURZ_ENDPOINT_ID=4454636175562375168


# General model
# -----------------------------------------------------------------------------

VERTEX_GENERAL_LOCATION=global
VERTEX_GENERAL_MODEL=gemini-3.5-flash-lite


# -----------------------------------------------------------------------------
# Vertex AI Auto-training
# -----------------------------------------------------------------------------

VERTEX_AUTOTRAIN_ENABLED=true
VERTEX_AUTOTRAIN_DAY=1
VERTEX_AUTOTRAIN_MIN_NEW_FEEDBACK=25
VERTEX_AUTOTRAIN_SOURCE=proposal_ai_prefill,dekurz_v2

VERTEX_AUTOTRAIN_DATASET_DISK=gcs
VERTEX_AUTOTRAIN_DATASET_PREFIX=ai/dekurz-feedback
VERTEX_AUTOTRAIN_LOCAL_DATASET_PATH=storage/app/private/ai-dataset-dekurz-feedback/train.jsonl
VERTEX_AUTOTRAIN_STATE_PATH=ai/dekurz-autotrain/state.json
VERTEX_PROPOSAL_AUTOTRAIN_STATE_PATH=ai/proposal-autotrain/state.json
VERTEX_PROPOSAL_AUTOTRAIN_DATASET_PREFIX=ai/proposal-feedback

VERTEX_AUTOTRAIN_TRAINING_ENDPOINT=tuningJobs
VERTEX_AUTOTRAIN_BASE_MODEL=publishers/google/models/gemini-3.5-flash
VERTEX_AUTOTRAIN_BASE_MODELS=
VERTEX_AUTOTRAIN_LOCATION=
VERTEX_AUTOTRAIN_MAX_EVALUATION_EXAMPLES=50

VERTEX_AUTOTRAIN_MIN_JSON_VALIDITY=1.00
VERTEX_AUTOTRAIN_MIN_REQUIRED_FIELDS_RATE=1.00
VERTEX_AUTOTRAIN_MAX_SCORE_REGRESSION=0.01
VERTEX_AUTOTRAIN_MAX_HTTP_FAILURES=0
VERTEX_AUTOTRAIN_MAX_CRITICAL_ERRORS=0

VERTEX_AUTOTRAIN_POLL_MINUTES=15
VERTEX_AUTOTRAIN_MAX_HOURS=48
VERTEX_AUTOTRAIN_RETENTION_DAYS=180
VERTEX_AUTOTRAIN_RUNTIME_FALLBACK=true
VERTEX_AUTOTRAIN_NOTIFICATION_EMAILS=adocare@studiokristian.com


# -----------------------------------------------------------------------------
# Backups
# -----------------------------------------------------------------------------

BACKUP_NAME=adocare

BACKUP_LOCAL_DISK=local
BACKUP_CLOUD_DISK=gcs
BACKUP_ARCHIVE_PASSWORD=

BACKUP_KEEP_ALL_DAYS=7
BACKUP_KEEP_DAILY_DAYS=30
BACKUP_KEEP_WEEKLY_WEEKS=12
BACKUP_KEEP_MONTHLY_MONTHS=24
BACKUP_KEEP_YEARLY_YEARS=5

BACKUP_MAX_STORAGE_MB=30000

BACKUP_HEALTH_MAX_AGE_DAYS=2
BACKUP_HEALTH_MAX_STORAGE_MB=30000